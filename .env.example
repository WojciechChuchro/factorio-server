# ─────────────────────────────────────────────────────────
#  Factorio Server — Environment Variables
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────

# Save management
LOAD_LATEST_SAVE=false
GENERATE_NEW_SAVE=false
SAVE_NAME=world

# Your factorio.com account credentials (optional).
# Required only if you want the server listed on the public server browser.
# Get your token at: https://www.factorio.com/profile
FACTORIO_USERNAME=
FACTORIO_TOKEN=

# Optional: in-game join password
# NOTE: the image does NOT read this env var directly.
# Set the join password via "game_password" in data/config/server-settings.json.
FACTORIO_PASSWORD=

# RCON (Remote Console) configuration
RCON_PORT=27015
RCON_PASSWORD=changeme

# RCON web UI (only used when --profile rcon is active)
RCON_WEB_PASSWORD=admin

# DLC toggles
DLC_SPACE_AGE=true
DLC_QUALITY=true
DLC_ELEVATED_RAILS=true

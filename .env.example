# ─────────────────────────────────────────────────────────
#  Factorio Server — Environment Variables
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────

# Your factorio.com account credentials (optional).
# Required only if you want the server listed on the public server browser.
# Get your token at: https://www.factorio.com/profile
FACTORIO_USERNAME=
FACTORIO_TOKEN=

# RCON (Remote Console) credentials — used by the RCON web UI
RCON_PASSWORD=admin

# RCON web UI admin password (only used when --profile rcon is active)
RCON_WEB_PASSWORD=admin
